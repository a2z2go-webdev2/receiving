# ─────────────────────────────────────────────────────────────────────────────
#  Receiving — Production Environment
#  Copy this to .env on your production server and fill in the values.
#  Lines marked [REQUIRED] must be set before first deploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Receiving"
APP_ENV=production
APP_KEY=                              # [REQUIRED] Generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.com       # [REQUIRED] Must be HTTPS
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1                     # [REQUIRED] Your PostgreSQL host
DB_PORT=5432
DB_DATABASE=receiving                 # [REQUIRED] Your database name
DB_USERNAME=postgres                  # [REQUIRED] Your database user
DB_PASSWORD=                          # [REQUIRED] Your database password
DB_SSLMODE=require

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue / Cache ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

# ── Filesystem (Cloudflare R2) ───────────────────────────────────────────────
FILESYSTEM_DISK=local
RECEIVING_DISK=r2
RECEIVING_PROXY_UPLOADS=true

R2_ACCESS_KEY_ID=                     # [REQUIRED] Your R2 access key
R2_SECRET_ACCESS_KEY=                 # [REQUIRED] Your R2 secret key
R2_REGION=auto
R2_BUCKET_NAME=receiving-uploads
R2_ENDPOINT=                          # [REQUIRED] Your R2 endpoint URL
R2_USE_PATH_STYLE_ENDPOINT=true

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=                        # [REQUIRED] Your SMTP email
MAIL_PASSWORD=                        # [REQUIRED] Your SMTP app password
MAIL_FROM_ADDRESS=                    # [REQUIRED] Sender email address
MAIL_FROM_NAME="${APP_NAME}"

# ── Initial Admin Seed ───────────────────────────────────────────────────────
# These are only used during `php artisan migrate --seed` (first deploy).
# You can remove them after the admin account is created.
INITIAL_ADMIN_NAME="Receiving Administrator"
INITIAL_ADMIN_EMAIL=t78534666@gmail.com
INITIAL_ADMIN_PASSWORD=               # [REQUIRED] Min 12 characters

# ── Malware Scanner (Cloudmersive) ──────────────────────────────────────────
RECEIVING_SCANNER_DRIVER=cloudmersive
CLOUDMERSIVE_API_KEY=
CLOUDMERSIVE_BASE_URL=https://api.cloudmersive.com
CLOUDMERSIVE_CONNECT_TIMEOUT_SECONDS=10
CLOUDMERSIVE_TIMEOUT_SECONDS=30
CLOUDMERSIVE_MONTHLY_CALL_LIMIT=800
CLOUDMERSIVE_MINIMUM_INTERVAL_MILLISECONDS=1100
CLOUDMERSIVE_MAX_FILE_KILOBYTES=3584
CLOUDMERSIVE_LOCK_WAIT_SECONDS=30
CLOUDMERSIVE_BUSY_RETRY_SECONDS=5
CLOUDMERSIVE_RATE_LIMIT_RETRY_SECONDS=60

# ── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                       # [REQUIRED] Your Gemini API key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=120
GEMINI_HTTP_ATTEMPTS=2
RECEIVING_AI_BATCH_SIZE=1
RECEIVING_AI_RETRY_LIMIT=3
RECEIVING_AI_RETRY_BACKOFF_SECONDS=60
RECEIVING_REVIEW_RECIPIENT_RULE=uploader
RECEIVING_WORKER_TIMEOUT_SECONDS=300
RECEIVING_WORKER_TIMEOUT_SAFETY_SECONDS=30

# ── File Processing ─────────────────────────────────────────────────────────
RECEIVING_OTP_EXPIRES_MINUTES=5
RECEIVING_OTP_MAX_ATTEMPTS=5
RECEIVING_OTP_GRANT_MINUTES=30
RECEIVING_MAX_FILES=10
RECEIVING_MAX_FILE_KILOBYTES=15360
RECEIVING_STAGING_URL_MINUTES=15
RECEIVING_STAGING_CLEANUP_HOURS=24
RECEIVING_SIGNED_URL_MINUTES=30
RECEIVING_REVIEW_LINK_HOURS=24
RECEIVING_COMPRESSION_ENABLED=true
RECEIVING_MAX_IMAGE_WIDTH=2400
RECEIVING_MAX_IMAGE_HEIGHT=2400
RECEIVING_JPEG_QUALITY=85
RECEIVING_ALLOW_ORIGINAL_ON_COMPRESSION_FAILURE=false

RECEIVING_LOCATION_MAX_ACCURACY_METERS=1000
RECEIVING_LOCATION_MAX_AGE_SECONDS=120

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714
